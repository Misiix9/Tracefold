{
  "name": "tracefold",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "Offline testing companion with an isolated plugin platform",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src package.json vite.config.ts svelte.config.js tsconfig.json",
    "format:check": "prettier --check src package.json vite.config.ts svelte.config.js tsconfig.json",
    "test:ui": "vitest run --config vite.ui.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "bits-ui": "^2.0.0",
    "docx": "^9.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.0",
    "pdfmake": "^0.3.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfmake": "^0.2.0",
    "happy-dom": "20.14.3",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
