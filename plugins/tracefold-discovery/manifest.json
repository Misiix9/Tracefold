{
  "schema": "tracefold.plugin.v1",
  "id": "tracefold.discovery",
  "name": "Tracefold Discovery",
  "version": "2.1.0",
  "publisher": "Tracefold",
  "description": "Authenticated website and API discovery with multi-user authorization testing. Crawls as a saved user, maps API calls to the pages that make them, and compares endpoint access across accounts.",
  "apiVersion": 1,
  "minTracefoldVersion": "0.2.1",
  "runtime": {
    "type": "loopback-web",
    "entry": "run.py",
    "command": "python3",
    "commandCandidates": ["python", "py"],
    "args": ["run.py", "--port", "{port}", "--data-dir", "{dataDir}"],
    "health": "/api/health",
    "bind": "127.0.0.1"
  },
  "capabilities": [
    "network.targeted-http",
    "browser.playwright",
    "local.encrypted-secrets",
    "local.files.app-data"
  ],
  "dataPolicy": {
    "persistentDirectory": "{dataDir}",
    "telemetry": false,
    "accountRequired": false
  }
}
